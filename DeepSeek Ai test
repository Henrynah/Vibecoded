local OBSIDIAN_URL = "https://raw.githubusercontent.com/Footagesus/Obsidian/main/Obsidian.lua"

-- Carrega Obsidian
local okLoad, Obsidian = pcall(function()
    return loadstring(game:HttpGet(OBSIDIAN_URL))()
end)

if not okLoad or not Obsidian then
    error("[ObsidianBetterOrion] Falha ao carregar Obsidian: " .. tostring(Obsidian))
end

-- ============================================================
-- Utilitários
-- ============================================================
local function log(msg)
    warn("[ObsidianBetterOrion] " .. tostring(msg))
end

local function safeCall(fn, ...)
    local ok, res = pcall(fn, ...)
    if not ok then
        log(tostring(res))
        return nil
    end
    return res
end

local function norm(cfg)
    cfg = cfg or {}
    return {
        Title    = cfg.Name or cfg.Title or "",
        Callback = cfg.Callback,
        Default  = cfg.Default,
        Min      = cfg.Min,
        Max      = cfg.Max,
        Inc      = cfg.Increment or 1,
        Options  = cfg.Options or {},
        Placeholder = cfg.Placeholder or "",
        Icon     = cfg.Icon,
    }
end

-- ============================================================
-- Metatables
-- ============================================================
local Window, Tab, Section, Toggle, Slider, Dropdown, Keybind

-- ---------- WINDOW ----------
Window = { __index = {
    MakeTab = function(self, cfg)
        local tab = self._native:CreateTab({
            Title = cfg.Name or cfg.Title or "Tab",
            Icon  = cfg.Icon,
        })
        return setmetatable({ _native = tab }, Tab)
    end,

    SelectTab = function(self, tab)
        safeCall(function() self._native:SelectTab(tab._native) end)
    end,

    Destroy = function(self)
        safeCall(function() self._native:Destroy() end)
    end,
} }

-- ---------- TAB ----------
Tab = { __index = {
    AddSection = function(self, cfg)
        local sec = self._native:CreateSection(cfg.Name or cfg.Title or "Section")
        return setmetatable({ _native = sec }, Section)
    end,
} }

-- ---------- SECTION ----------
Section = { __index = {
    AddToggle = function(self, cfg)
        local c = norm(cfg)
        local t = safeCall(function()
            return self._native:CreateToggle({
                Title    = c.Title,
                Default  = c.Default or false,
                Callback = c.Callback,
            })
        end)
        if not t then return nil end
        return setmetatable({ _native = t, _section = self }, Toggle)
    end,

    AddSlider = function(self, cfg)
        local c = norm(cfg)
        local s = safeCall(function()
            return self._native:CreateSlider({
                Title     = c.Title,
                Min       = c.Min or 0,
                Max       = c.Max or 100,
                Default   = c.Default or 0,
                Increment = c.Inc,
                Callback  = c.Callback,
            })
        end)
        if not s then return nil end
        return setmetatable({ _native = s }, Slider)
    end,

    AddButton = function(self, cfg)
        local c = norm(cfg)
        return safeCall(function()
            return self._native:CreateButton({
                Title    = c.Title,
                Callback = c.Callback,
            })
        end)
    end,

    AddDropdown = function(self, cfg)
        local c = norm(cfg)
        local d = safeCall(function()
            return self._native:CreateDropdown({
                Title    = c.Title,
                Options  = c.Options,
                Default  = c.Default,
                Callback = c.Callback,
            })
        end)
        if not d then return nil end
        return setmetatable({ _native = d }, Dropdown)
    end,

    AddLabel = function(self, cfg)
        local c = norm(cfg)
        return safeCall(function()
            return self._native:CreateLabel(c.Title)
        end)
    end,

    AddInput = function(self, cfg)
        local c = norm(cfg)
        return safeCall(function()
            return self._native:CreateInput({
                Title       = c.Title,
                Placeholder = c.Placeholder,
                Default     = c.Default,
                Callback    = c.Callback,
            })
        end)
    end,

    AddKeybind = function(self, cfg)
        local c = norm(cfg)
        local k = safeCall(function()
            return self._native:CreateKeybind({
                Title    = c.Title,
                Default  = c.Default,
                Callback = c.Callback,
            })
        end)
        if not k then return nil end
        return setmetatable({ _native = k }, Keybind)
    end,

    AddParagraph = function(self, cfg)
        local c = norm(cfg)
        return safeCall(function()
            return self._native:CreateParagraph({
                Title   = c.Title,
                Content = cfg.Content or "",
            })
        end)
    end,

    AddColorpicker = function(self, cfg)
        local c = norm(cfg)
        return safeCall(function()
            return self._native:CreateColorpicker({
                Title    = c.Title,
                Default  = c.Default,
                Callback = c.Callback,
            })
        end)
    end,

    -- Se chamarem AddSection em uma Section, retorna ela mesma
    AddSection = function(self, _) return self end,
} }

-- ---------- TOGGLE (aceita slider/dropdown aninhado) ----------
Toggle = { __index = {
    AddSlider   = function(self, cfg) return self._section and self._section:AddSlider(cfg) end,
    AddDropdown = function(self, cfg) return self._section and self._section:AddDropdown(cfg) end,
    AddKeybind  = function(self, cfg) return self._section and self._section:AddKeybind(cfg) end,

    Set = function(self, v)
        safeCall(function() self._native:Set(v) end)
    end,
    Get = function(self)
        return safeCall(function() return self._native:Get() end)
    end,
} }

-- ---------- SLIDER ----------
Slider = { __index = {
    Set = function(self, v) safeCall(function() self._native:Set(v) end) end,
    Get = function(self) return safeCall(function() return self._native:Get() end) end,
} }

-- ---------- DROPDOWN ----------
Dropdown = { __index = {
    Set     = function(self, v) safeCall(function() self._native:Set(v) end) end,
    Get     = function(self) return safeCall(function() return self._native:Get() end) end,
    Refresh = function(self, list) safeCall(function() self._native:Refresh(list) end) end,
} }

-- ---------- KEYBIND ----------
Keybind = { __index = {
    Set = function(self, k) safeCall(function() self._native:Set(k) end) end,
} }

-- ============================================================
-- Entry point
-- ============================================================
local Orion = {}

function Orion:MakeWindow(cfg)
    cfg = cfg or {}
    local w = Obsidian:CreateWindow({
        Title    = cfg.Name or cfg.Title or "Window",
        Subtitle = cfg.SubName or cfg.Subtitle or "",
        Icon     = cfg.Icon,
    })
    return setmetatable({ _native = w }, Window)
end

function Orion:MakeNotification(cfg)
    cfg = cfg or {}
    return safeCall(function()
        return Obsidian:Notify({
            Title       = cfg.Name or cfg.Title or "",
            Description = cfg.Content or cfg.Description or "",
            Duration    = cfg.Time or cfg.Duration or 5,
            Icon        = cfg.Image,
        })
    end)
end

Orion.CreateWindow       = Orion.MakeWindow
Orion.CreateNotification = Orion.MakeNotification
Orion.__Obsidian         = Obsidian

return Orion
